@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-5">
                <i class="bi bi-box-seam fs-1 text-primary"></i>
                <h1 class="display-5 fw-bold mt-3">Welcome Back</h1>
                <p class="text-muted lead">Sign in to access your warehouse management dashboard</p>
            </div>

            <div class="row g-4">
                <!-- Local Login Card -->
                <div class="@((Model.ExternalLogins?.Count ?? 0) > 0 ? "col-md-6" : "col-md-8 mx-auto")">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <i class="bi bi-person-circle fs-3 text-primary me-3"></i>
                                <h3 class="mb-0">Sign In</h3>
                            </div>
                            
                            <form id="account" method="post">
                                @if (!ViewData.ModelState.IsValid)
                                {
                                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                        <div>
                                            @foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                                            {
                                                <span>@error.ErrorMessage</span>
                                            }
                                        </div>
                                    </div>
                                }
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary-errors-custom" role="alert"></div>
                                
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                                        placeholder="name@example.com" />
                                    <label asp-for="Input.Email" class="form-label">
                                        <i class="bi bi-envelope me-1"></i> Email
                                    </label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                                
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                                        aria-required="true" placeholder="password" />
                                    <label asp-for="Input.Password" class="form-label">
                                        <i class="bi bi-lock me-1"></i> Password
                                    </label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                                
                                <div class="form-check mb-4">
                                    <input class="form-check-input" asp-for="Input.RememberMe" />
                                    <label asp-for="Input.RememberMe" class="form-check-label">
                                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                                    </label>
                                </div>
                                
                                <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                                </button>
                                
                                <div class="text-center">
                                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none">
                                        <i class="bi bi-key me-1"></i> Forgot your password?
                                    </a>
                                </div>
                            </form>
                        </div>
                        
                        <div class="card-footer bg-light text-center py-3">
                            <span class="text-muted">New to Warehouse CMS?</span>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold ms-1">
                                Create an account
                            </a>
                        </div>
                    </div>
                </div>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <!-- External Login Card -->
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-4">
                                    <i class="bi bi-shield-check fs-3 text-success me-3"></i>
                                    <h3 class="mb-0">Quick Sign In</h3>
                                </div>
                                
                                <p class="text-muted mb-4">
                                    Sign in quickly using your existing account from these services:
                                </p>
                                
                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                    <div class="d-grid gap-2">
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-outline-primary btn-lg" name="provider" value="@provider.Name"
                                                title="Log in using your @provider.DisplayName account">
                                                @if (provider.Name.ToLower() == "google")
                                                {
                                                    <i class="bi bi-google me-2"></i>
                                                }
                                                else if (provider.Name.ToLower() == "microsoft")
                                                {
                                                    <i class="bi bi-microsoft me-2"></i>
                                                }
                                                else if (provider.Name.ToLower() == "facebook")
                                                {
                                                    <i class="bi bi-facebook me-2"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-shield-check me-2"></i>
                                                }
                                                Continue with @provider.DisplayName
                                            </button>
                                        }
                                    </div>
                                </form>
                            </div>
                            
                            <div class="card-footer bg-light text-center py-3">
                                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-decoration-none text-muted small">
                                    <i class="bi bi-envelope-check me-1"></i> Resend email confirmation
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Security Notice -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="alert alert-info border-0 shadow-sm">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-shield-lock fs-4 me-3"></i>
                            <div>
                                <strong>Secure Connection</strong>
                                <p class="mb-0 small">Your login credentials are encrypted and transmitted securely. We take your privacy seriously.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom styles for the login page */
    .card {
        border: none;
        transition: transform 0.2s;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .form-control:focus {
        border-color: #1b6ec2;
        box-shadow: 0 0 0 0.2rem rgba(27, 110, 194, 0.25);
    }
    
    .btn-outline-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(27, 110, 194, 0.15);
    }
    
    /* Show validation summary only when it has content */
    .validation-summary-errors-custom.validation-summary-valid {
        display: none;
    }
    .validation-summary-errors-custom.validation-summary-errors {
        display: block;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var $btn = $('#login-submit');
            var originalBtnHtml = $btn.html();

            // Re-enable button if page reloaded with errors
            if ($('.alert-danger:visible').length > 0 || $('.validation-summary-errors').length > 0) {
                $btn.html(originalBtnHtml).prop('disabled', false);
            }

            $('#account').on('submit', function() {
                if ($(this).valid()) {
                    $btn.html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Signing in...').prop('disabled', true);
                }
            });
        });
    </script>
}