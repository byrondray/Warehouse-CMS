@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Warehouse_CMS.styles.css" asp-append-version="true" />
    <meta name="globalsign-domain-verification" content="disable-source-maps">
</head>

<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Warehouse
                        Manager</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li><a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Products</a></li>
                            <li><a class="nav-link text-dark" asp-controller="Order" asp-action="Index">Orders</a></li>
                            <li class="nav-item" asp-authorize asp-roles="Admin,Manager">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Roles"
                                    asp-action="Index">Roles</a>
                            </li>
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container @(SignInManager.IsSignedIn(User) ? "" : "mt-5")">
        <main role="main" class="pb-3">
            <div id="content-container">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Warehouse_CMS - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Prevent duplicate initialization
            if (window.spaInitialized) {
                console.log("SPA already initialized, skipping");
                return;
            }
            window.spaInitialized = true;

            let requestCounter = 0;

            // Simple, robust event delegation for SPA navigation
            $(document).on('click', 'a[href^="/"]', function (e) {
                var $link = $(this);
                var url = $link.attr('href');

                console.log("Link clicked:", url, "Link text:", $link.text().trim());

                // Skip certain types of links
                if (url.includes("/Identity/") ||
                    $link.attr('target') === '_blank' ||
                    $link.hasClass('no-spa')) {
                    console.log("Skipping SPA for:", url);
                    return true; // Let default behavior happen
                }

                console.log("Processing SPA navigation to:", url);
                e.preventDefault();
                navigateToUrl(url);
                return false;
            });

            function navigateToUrl(url) {
                console.log("SPA navigation to: " + url);
                window.history.pushState({ path: url }, '', url);
                loadContent(url);
            }

            $(document).on('submit', 'form:not([action*="Identity"])', function (e) {
                e.preventDefault();
                console.log("Form submission via SPA");

                var $form = $(this);
                var url = $form.attr('action') || window.location.pathname;
                var method = $form.attr('method') || 'GET';

                $.ajax({
                    url: url,
                    type: method,
                    data: $form.serialize(),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function (response) {
                        if (typeof response === 'object' && response.redirectTo) {
                            console.log("SPA redirect to: " + response.redirectTo);
                            window.history.pushState({ path: response.redirectTo }, '', response.redirectTo);
                            loadContent(response.redirectTo);
                        } else {
                            $('#content-container').html(response);
                            reattachValidation();
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Form submission error:", error, "Status code:", xhr.status);

                        if (xhr.status === 401 || xhr.status === 403) {
                            window.location.href = '/Identity/Account/AccessDenied';
                            return;
                        }

                        if (xhr.status === 400 && xhr.responseJSON) {
                            const errors = xhr.responseJSON;
                            for (const key in errors) {
                                $(`[data-valmsg-for="${key}"]`).text(errors[key]);
                            }
                        } else {
                            $('#content-container').html('Error processing your request. Please try again.');
                        }
                    }
                });
            });

            $(window).on('popstate', function (e) {
                var url = window.location.pathname;
                console.log("Popstate navigation to: " + url);

                if (url.includes("/Identity/")) {
                    window.location.href = url;
                    return;
                }

                loadContent(url);
            });

            function loadContent(url) {
                requestCounter++;
                console.log(`Loading content #${requestCounter} from: ${url}`);

                $('#content-container').html('<div class="text-center mt-5"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>');

                $.ajax({
                    url: url,
                    type: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    timeout: 10000,
                    success: function (data, textStatus, xhr) {
                        console.log("AJAX success, status:", xhr.status, "Content length:", data.length);
                        try {
                            // Simple approach: replace content directly
                            $('#content-container').html(data);
                            console.log("Content loaded and replaced successfully");
                            reattachValidation();
                        } catch (e) {
                            console.error("Error processing content:", e);
                            $('#content-container').html('<div class="alert alert-danger">Error processing content: ' + e.message + '</div>');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX error:", status, error, "Status code:", xhr.status);

                        if (xhr.status === 401 || xhr.status === 403) {
                            window.location.href = '/Identity/Account/AccessDenied';
                            return;
                        }

                        $('#content-container').html('<div class="alert alert-danger">Error loading content. Status: ' + xhr.status + ', Error: ' + error + '</div>');
                    }
                });
            }

            function reattachValidation() {
                console.log("Reattaching validation and bootstrap components");

                // Re-parse validation for new forms
                if (typeof $.validator !== 'undefined') {
                    $.validator.unobtrusive.parse('#content-container');
                }

                // Re-initialize Bootstrap components
                if (typeof bootstrap !== 'undefined') {
                    // Dispose existing tooltips/popovers first
                    $('#content-container [data-bs-toggle="tooltip"]').each(function () {
                        var tooltip = bootstrap.Tooltip.getInstance(this);
                        if (tooltip) tooltip.dispose();
                    });
                    $('#content-container [data-bs-toggle="popover"]').each(function () {
                        var popover = bootstrap.Popover.getInstance(this);
                        if (popover) popover.dispose();
                    });

                    // Initialize new ones
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('#content-container [data-bs-toggle="tooltip"]'));
                    tooltipTriggerList.map(function (tooltipTriggerEl) {
                        return new bootstrap.Tooltip(tooltipTriggerEl);
                    });

                    var popoverTriggerList = [].slice.call(document.querySelectorAll('#content-container [data-bs-toggle="popover"]'));
                    popoverTriggerList.map(function (popoverTriggerEl) {
                        return new bootstrap.Popover(popoverTriggerEl);
                    });

                    // Handle alerts
                    var alertList = [].slice.call(document.querySelectorAll('#content-container .alert:not(.alert-initialized)'));
                    alertList.forEach(function (alert) {
                        alert.classList.add('alert-initialized');
                        setTimeout(function () {
                            $(alert).fadeOut('slow', function () {
                                $(this).remove();
                            });
                        }, 5000);
                    });
                }

                $(document).trigger('content-updated');
            }

            console.log("jQuery SPA initialized at: " + new Date().toISOString());

            // Handle hash-based URLs immediately and consistently
            function handleHashUrl() {
                var hash = window.location.hash;
                console.log("handleHashUrl called, full URL:", window.location.href, "hash:", hash);
                if (hash && hash.length > 1) {
                    var path = hash.substring(1); // Remove the #
                    if (!path.startsWith('/')) {
                        path = '/' + path; // Ensure it starts with /
                    }
                    console.log("Converting hash URL to clean path:", path);
                    // Clear the hash and navigate
                    window.history.replaceState({ path: path }, '', path);
                    loadContent(path);
                    return true;
                }
                return false;
            }

            // Handle hash changes and initial hash
            function checkForHash() {
                if (window.location.hash) {
                    console.log("Hash found:", window.location.hash);
                    handleHashUrl();
                } else {
                    console.log("No hash in URL");
                }
            }

            // Check immediately on page load
            checkForHash();

            // Also handle hash changes
            $(window).on('hashchange', function () {
                console.log("Hash change event triggered");
                checkForHash();
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>